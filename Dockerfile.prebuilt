FROM node:22-alpine AS frontend
WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
RUN npm run build

FROM alpine:3.20
RUN adduser -D -u 10001 appuser && apk add --no-cache ca-certificates && mkdir -p /data/jira && chown appuser /data/jira
COPY bin/knowledge-api-linux /usr/local/bin/knowledge-api
USER appuser
COPY --from=frontend /ui/dist /opt/bobby
ENV BOBBY_WEB_ROOT=/opt/bobby
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/knowledge-api"]
