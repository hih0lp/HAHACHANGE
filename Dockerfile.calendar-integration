FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/calendar-integration ./cmd/calendar-integration
RUN CGO_ENABLED=0 go build -trimpath -o /calendar-integration ./cmd/calendar-integration
FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /calendar-integration /usr/local/bin/calendar-integration
USER 10001
ENTRYPOINT ["/usr/local/bin/calendar-integration"]
