FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/mock-calendar ./cmd/mock-calendar
RUN CGO_ENABLED=0 go build -trimpath -o /mock-calendar ./cmd/mock-calendar
FROM alpine:3.20
COPY --from=build /mock-calendar /usr/local/bin/mock-calendar
USER 10001
ENTRYPOINT ["/usr/local/bin/mock-calendar"]
