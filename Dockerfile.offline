FROM node:22-alpine AS frontend
WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
RUN npm run build

FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
RUN go test ./... && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/knowledge-api ./cmd/server

FROM golang:1.23-alpine
RUN adduser -D -u 10001 appuser && mkdir -p /data/jira && chown appuser /data/jira
COPY --from=build /out/knowledge-api /usr/local/bin/knowledge-api
USER appuser
COPY --from=frontend /ui/dist /opt/bobby
ENV BOBBY_WEB_ROOT=/opt/bobby
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/knowledge-api"]
