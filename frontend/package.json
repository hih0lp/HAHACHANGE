{
  "name": "bobby-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test test/*.test.ts",
    "test:browser": "node test/browser.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "playwright": "1.65.0",
    "typescript": "5.5.4",
    "vite": "7.3.7"
  }
}
