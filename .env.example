# Set this before exposing the API beyond localhost. Empty means no API key.
API_KEY=

COLLECTION_NAME=avito_playbook
CHUNK_SIZE=1100
CHUNK_OVERLAP=180
LLM_MODEL=qwen3-8b
LLM_URL=http://host.docker.internal:1234

# Parallel background questions and bounded waiting queue.
JOB_WORKERS=2
JOB_QUEUE_SIZE=32
JOB_TIMEOUT_SECONDS=180

# Jira test project. Keep mock until you enter a fresh token locally.
JIRA_MODE=mock
JIRA_BASE_URL=https://gapshinmihael.atlassian.net
JIRA_PROJECT_KEY=SCRUM
JIRA_ISSUE_TYPE=Задача
JIRA_EMAIL=
JIRA_API_TOKEN=

# Distributed Compose only. Use independent random values in the server .env.
POSTGRES_DB=aibuddy
POSTGRES_USER=aibuddy
POSTGRES_PASSWORD=
DATABASE_URL=
SESSION_SECRET=
REDIS_ADDR=redis:6379
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=ai-buddy-requests
KAFKA_GROUP=ai-buddy-workers
JOB_MAX_ATTEMPTS=3

# Enable /onboarding only when the real SDD-007 service is available.
TEAM_ACCESS_URL=

