# Set this before exposing the API beyond localhost. Empty means no API key.
API_KEY=

COLLECTION_NAME=avito_playbook
CHUNK_SIZE=1100
CHUNK_OVERLAP=180
LLM_MODEL=qwen3-8b
LLM_URL=http://host.docker.internal:1234
LLM_API_KEY=

# Parallel background questions and bounded waiting queue.
JOB_WORKERS=2
JOB_QUEUE_SIZE=32
JOB_TIMEOUT_SECONDS=180

# Jira is disabled by default. Set live only with valid credentials.
JIRA_MODE=off
JIRA_BASE_URL=https://gapshinmihael.atlassian.net
JIRA_PROJECT_KEY=SCRUM
JIRA_ISSUE_TYPE=Задача
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional directory user ID -> real Jira account ID mapping. Without it, employees have demo links.
TEAM_JIRA_ACCOUNTS_JSON=

# Reminder demo: one Jira assignee, with a configurable pre-deadline window.
REMINDER_INTERN_ACCOUNT_ID=
REMINDER_HOURS_BEFORE=48
REMINDER_TIMEZONE=Europe/Moscow

# Distributed Compose only. Use independent random values in the server .env.
POSTGRES_DB=aibuddy
POSTGRES_USER=aibuddy
POSTGRES_PASSWORD=
DATABASE_URL=
SESSION_SECRET=
REDIS_ADDR=redis:6379
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=ai-buddy-requests
KAFKA_GROUP=ai-buddy-workers
JOB_MAX_ATTEMPTS=3
TEAM_ACCESS_URL=
TEAM_ACCESS_INTERN_PASSWORD=
TEAM_ACCESS_INTERN2_PASSWORD=
TEAM_ACCESS_APPROVER_PASSWORD=
TEAM_ACCESS_SEED_JIRA_URL=

# Optional integration overlays. Token paths point outside the repository.
GITLAB_API_ORIGIN=
GITLAB_DEMO_SUBJECT=
GITLAB_DEMO_TOKEN_PATH=
GITLAB_REMINDER_PROJECT=2
CALENDAR_DEMO_SUBJECT=
CALENDAR_ONBOARDING_ID=
CALENDAR_MENTOR_ID=
GOOGLE_CLIENT_ID_PATH=
GOOGLE_CLIENT_SECRET_PATH=
GOOGLE_REFRESH_TOKEN_PATH=

